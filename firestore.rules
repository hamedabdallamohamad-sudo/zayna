rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ← ضعي بريد حساب المدير هنا
    function isAdmin() {
      return request.auth != null && request.auth.token.email == 'admin@example.com';
    }
    match /products/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /orders/{id} {
      allow create: if request.resource.data.keys().hasOnly(['orderNo', 'items', 'total', 'createdAt'])
                    && request.resource.data.items is list
                    && request.resource.data.items.size() > 0
                    && request.resource.data.items.size() <= 50
                    && request.resource.data.total is number
                    && request.resource.data.createdAt == request.time;
      allow read, update, delete: if isAdmin();
    }
  }
}
